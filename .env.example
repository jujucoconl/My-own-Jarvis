# Copy to .env and fill in. Never commit the real .env file.

# --- Claude (used to triage email importance, draft replies, and suggest downtime activities) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google (Gmail + Google Calendar) ---
# Create an OAuth client (Desktop app) at https://console.cloud.google.com/apis/credentials
# with the Gmail API and Calendar API enabled, then download the JSON as credentials.json.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=.google_token.json

# --- Microsoft 365 / Outlook ---
# Register a public client app at https://portal.azure.com (Azure AD App registrations),
# no client secret needed since we use the device-code flow.
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_TOKEN_CACHE_PATH=.ms_token_cache.bin
